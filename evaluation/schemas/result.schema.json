{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "product_failure",
        "infrastructure_failure",
        "grading_dispute",
        "insufficient_evidence",
        "not_implemented",
        "not_run"
      ]
    },
    "executionTrack": {
      "type": "string",
      "enum": ["desktop_proxy", "diagnostic", "semantic_calibration"]
    },
    "blinded": {
      "type": "boolean"
    },
    "mockService": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": ["boolean", "null"]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["id", "passed", "observation", "evidence"],
        "additionalProperties": false
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["dimension", "score", "observation", "evidence"],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["agent_proxy", "programmatic"]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "independentContext": {
          "type": "boolean"
        }
      },
      "required": ["kind", "identity", "independentContext"],
      "additionalProperties": false
    },
    "forbiddenChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "absent": {
            "type": "boolean"
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["index", "absent", "observation", "evidence"],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "modelRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["elapsedMs", "modelRequests", "cost"],
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "caseId",
    "attempt",
    "status",
    "executionTrack",
    "blinded",
    "mockService",
    "startedAt",
    "endedAt",
    "checks",
    "scores",
    "artifacts",
    "limitations",
    "reviewer",
    "metrics"
  ],
  "additionalProperties": {}
}
