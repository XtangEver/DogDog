{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "fromLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "toLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "contains": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["file", "fromLine", "toLine", "contains"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "statement", "evidence"],
        "additionalProperties": false
      }
    },
    "counterEvidence": {
      "type": "array",
      "items": {}
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedConclusions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenConclusions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rubric": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "zero": {
            "type": "string",
            "minLength": 1
          },
          "one": {
            "type": "string",
            "minLength": 1
          },
          "two": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["dimension", "zero", "one", "two"],
        "additionalProperties": false
      }
    },
    "positiveExamples": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["answer", "rationale"],
        "additionalProperties": false
      }
    },
    "negativeExamples": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["answer", "rationale"],
        "additionalProperties": false
      }
    },
    "alternativeValidExamples": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["answer", "rationale"],
        "additionalProperties": false
      }
    },
    "checks": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mustId": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["mustId", "method", "expected"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "facts",
    "counterEvidence",
    "unknowns",
    "allowedConclusions",
    "forbiddenConclusions",
    "rubric",
    "positiveExamples",
    "negativeExamples",
    "alternativeValidExamples",
    "checks"
  ],
  "additionalProperties": {}
}
