{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "application": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "executableSha256": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["version", "executable", "executableSha256", "build"],
      "additionalProperties": false
    },
    "suiteVersion": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "executionTrack": {
      "type": "string",
      "minLength": 1
    },
    "mockService": {
      "type": "boolean"
    },
    "model": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["protocol", "name", "endpoint", "configuration"],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "width": {
          "type": ["number", "null"]
        },
        "height": {
          "type": ["number", "null"]
        },
        "scale": {
          "type": ["number", "null"]
        }
      },
      "required": ["width", "height", "scale"],
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "traceRoots": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["profile", "traceRoots", "excluded"],
      "additionalProperties": false
    },
    "fixtureHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "caseIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "application",
    "suiteVersion",
    "platform",
    "executionTrack",
    "mockService",
    "model",
    "display",
    "isolation",
    "fixtureHashes",
    "sourceRevision",
    "caseIds"
  ],
  "additionalProperties": {}
}
